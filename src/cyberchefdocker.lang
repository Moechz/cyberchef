# ===========================================================================
# Multilingual file for the TOS 7 Docker application "cyberchefdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "CyberChef"
auth         = "gchq"
version      = "@@VERSION@@"
descript     = "CyberChef is a web-based 'cyber swiss army knife': encode, decode, encrypt, hash, parse and transform data with more than 400 operations that you drag into a recipe. Handy for base64, JWT, hex, gzip, timestamps and log parsing. Recipes and data are processed in your own browser - the NAS only serves the static page and the developer receives nothing."
release_note = "11.6.0-1: remediation of the listing review (C3/C4/C5/C6/C7/T1). Upgraded to upstream CyberChef 11.6.0 - current nginx base image and current bundled JS dependencies, which addresses the scanned CVEs; added a complete privacy policy linked from Help; the description now discloses the three opt-in network operations; licence metadata corrected; README expanded."
important    = "Requires DockerEngine (auto-installed if missing). Everything runs in your browser: input and recipes never reach the container or the developer. Only three optional operations use the internet: HTTP request (the URL you type), DNS over HTTPS (Google or Cloudflare) and Show on map (unpkg.com + OpenStreetMap tiles). The UI is plain HTTP; use a TLS reverse proxy for remote access. No user content is stored on the NAS."

[zh-cn]
name         = "CyberChef"
auth         = "gchq"
version      = "@@VERSION@@"
descript     = "CyberChef 是网页版的「数据处理瑞士军刀」：把 400 多个操作拖成配方，就能做编码/解码、加解密、哈希、解析与格式转换。处理 base64、JWT、十六进制、gzip、时间戳、日志都很方便。配方与数据都在你自己的浏览器里处理——NAS 只负责发送静态页面，开发者不会收到任何数据。"
release_note = "11.6.0-1：针对上轮审核意见的整改（C3/C4/C5/C6/C7/T1）。升级到上游 CyberChef 11.6.0——新的 nginx 基础镜像与当前版本的 JS 依赖，修复扫描报告中的 CVE；新增完整隐私政策并由「帮助」链接；描述中如实说明三个可选的外网操作；修正许可证信息；补全 README。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。所有运算都在浏览器本地完成：输入与配方不会发到容器，也不会发给开发者。只有三个可选操作在使用时会访问外网：HTTP request（你填写的网址）、DNS over HTTPS（Google 或 Cloudflare）、Show on map（unpkg.com + OpenStreetMap 瓦片），除此之外不发起任何请求。界面为纯 HTTP，若要从外网访问请配置带 TLS 的反向代理。NAS 上不保存任何用户内容，因此没有需要备份的数据。"

[zh-hk]
name         = "CyberChef"
auth         = "gchq"
version      = "@@VERSION@@"
descript     = "CyberChef 是網頁版的「資料處理瑞士軍刀」：把 400 多個操作拖成配方，就能做編碼/解碼、加解密、雜湊、解析與格式轉換。處理 base64、JWT、十六進位、gzip、時間戳、日誌都很方便。配方與資料都在你自己的瀏覽器裡處理——NAS 只負責傳送靜態頁面，開發者不會收到任何資料。"
release_note = "11.6.0-1：針對上輪審核意見的整改（C3/C4/C5/C6/C7/T1）。升級到上游 CyberChef 11.6.0——新的 nginx 基礎映像與現行版本的 JS 相依套件，修復掃描報告中的 CVE；新增完整隱私政策並由「說明」連結；描述中如實說明三個可選的外網操作；修正授權資訊；補齊 README。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。所有運算都在瀏覽器本地完成：輸入與配方不會傳到容器，也不會傳給開發者。只有三個可選操作在使用時會連上外網：HTTP request（你填寫的網址）、DNS over HTTPS（Google 或 Cloudflare）、Show on map（unpkg.com + OpenStreetMap 圖磚），除此之外不發出任何請求。介面為純 HTTP，若要從外網存取請配置帶 TLS 的反向代理。NAS 上不儲存任何使用者內容，因此沒有需要備份的資料。"

